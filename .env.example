# =============================================
#  VenueVault – Environment Variables Template
#  Copy this file to .env and fill in your values
# =============================================

PORT=3000
NODE_ENV=development

# MongoDB connection string (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/venuevault?retryWrites=true&w=majority

# Session secret – use a long random string in production
SESSION_SECRET=venuevault_super_secret_session_key_change_me_in_production

# Razorpay (mocked for dev)
RAZORPAY_KEY_ID=rzp_test_mockKey
RAZORPAY_KEY_SECRET=mock_secret
