<%- include('../partials/header', { title: 'Manage Venues' }) %>
<%- include('../partials/flash-messages') %>

<div class="flex min-h-[calc(100vh-4rem)]">
  <%- include('../partials/sidebar', { activePage: 'admin-venues' }) %>

  <div class="flex-1 overflow-auto bg-slate-50 p-6 lg:p-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Manage Venues</h1>
        <p class="text-slate-500 text-sm mt-1"><%= (venues || []).length %> total venues</p>
      </div>
      <a href="/admin/venues/new"
         class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-all active:scale-95 shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        Add Venue
      </a>
    </div>

    <!-- Venues Grid -->
    <% if ((venues || []).length === 0) { %>
      <div class="bg-white rounded-2xl border border-slate-100 shadow-card text-center py-20">
        <p class="text-slate-400 mb-4">No venues yet. Add your first one!</p>
        <a href="/admin/venues/new" class="inline-block bg-indigo-600 text-white text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-indigo-700 transition-colors">
          Add Venue
        </a>
      </div>
    <% } else { %>
      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">
        <% (venues || []).forEach(venue => { %>
          <div class="bg-white rounded-2xl border border-slate-100 shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-0.5 overflow-hidden">
            <!-- Image -->
            <div class="relative h-40 bg-slate-100">
              <% if (venue.images && venue.images.length > 0) { %>
                <img src="<%= venue.images[0] %>" alt="<%= venue.name %>"
                     class="w-full h-full object-cover"
                     onerror="this.src='https://images.unsplash.com/photo-1497366216548-37526070297c?w=800&q=80'" />
              <% } else { %>
                <div class="w-full h-full bg-gradient-to-br from-indigo-50 to-slate-100 flex items-center justify-center">
                  <svg class="w-10 h-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16"/>
                  </svg>
                </div>
              <% } %>
              <span class="absolute top-2 right-2 text-xs font-semibold px-2 py-0.5 rounded-full
                <%= venue.status === 'Active' ? 'bg-emerald-500 text-white' : 'bg-amber-500 text-white' %>">
                <%= venue.status %>
              </span>
            </div>
            <div class="p-5">
              <h2 class="font-semibold text-slate-900 truncate mb-1"><%= venue.name %></h2>
              <p class="text-xs text-slate-500 mb-3"><%= venue.location %></p>
              <div class="flex items-center justify-between text-sm mb-4">
                <span class="text-slate-600"><%= venue.capacity %> guests</span>
                <span class="font-bold text-indigo-600">₹<%= venue.pricePerHour.toLocaleString() %>/hr</span>
              </div>
              <div class="flex gap-2">
                <a href="/admin/venues/<%= venue._id %>/edit"
                   class="flex-1 text-center text-xs font-semibold px-3 py-2 rounded-lg border border-indigo-200 text-indigo-600 hover:bg-indigo-50 transition-colors">
                  Edit
                </a>
                <a href="/venues/<%= venue._id %>"
                   class="flex-1 text-center text-xs font-semibold px-3 py-2 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 transition-colors">
                  Preview
                </a>
                <form action="/admin/venues/<%= venue._id %>?_method=DELETE" method="POST"
                      onsubmit="return confirm('Permanently delete this venue and all its bookings?')">
                  <button type="submit"
                          class="text-xs font-semibold px-3 py-2 rounded-lg border border-rose-200 text-rose-500 hover:bg-rose-50 transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
