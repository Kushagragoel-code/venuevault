<%- include('../partials/header', { title: venue ? 'Edit Venue' : 'Add New Venue' }) %>
<%- include('../partials/flash-messages') %>

<div class="flex min-h-[calc(100vh-4rem)]">
  <%- include('../partials/sidebar', { activePage: 'admin-venues' }) %>

  <div class="flex-1 overflow-auto bg-slate-50 p-6 lg:p-8">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-slate-500 mb-6">
      <a href="/admin/venues" class="hover:text-indigo-600 transition-colors">Venues</a>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-slate-900 font-medium"><%= venue ? 'Edit' : 'New Venue' %></span>
    </nav>

    <div class="max-w-3xl">
      <h1 class="text-2xl font-bold text-slate-900 mb-6"><%= venue ? 'Edit Venue' : 'Add New Venue' %></h1>

      <div class="bg-white rounded-2xl border border-slate-100 shadow-card p-6 sm:p-8">
        <form action="<%= action %>" method="<%= method %>" id="venue-form" class="space-y-6">

          <div class="grid sm:grid-cols-2 gap-5">
            <!-- Name -->
            <div class="sm:col-span-2">
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Venue Name *</label>
              <input type="text" name="name" required
                     value="<%= venue ? venue.name : '' %>"
                     placeholder="e.g. Grand Ballroom & Conference Suite"
                     class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500" />
            </div>

            <!-- Location -->
            <div class="sm:col-span-2">
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Location *</label>
              <input type="text" name="location" required
                     value="<%= venue ? venue.location : '' %>"
                     placeholder="e.g. Connaught Place, New Delhi"
                     class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500" />
            </div>

            <!-- Capacity -->
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Capacity (guests) *</label>
              <input type="number" name="capacity" required min="1"
                     value="<%= venue ? venue.capacity : '' %>"
                     placeholder="e.g. 250"
                     class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500" />
            </div>

            <!-- Price per hour -->
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Price per Hour (₹) *</label>
              <input type="number" name="pricePerHour" required min="0" step="0.01"
                     value="<%= venue ? venue.pricePerHour : '' %>"
                     placeholder="e.g. 5000"
                     class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500" />
            </div>

            <!-- Status -->
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Status</label>
              <select name="status"
                      class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500">
                <option value="Active"      <%= venue && venue.status === 'Active'      ? 'selected' : '' %>>Active</option>
                <option value="Maintenance" <%= venue && venue.status === 'Maintenance' ? 'selected' : '' %>>Maintenance</option>
              </select>
            </div>

            <!-- Amenities -->
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Amenities</label>
              <input type="text" name="amenities"
                     value="<%= venue ? venue.amenities.join(', ') : '' %>"
                     placeholder="WiFi, Parking, AV Equipment, Catering"
                     class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500" />
              <p class="text-xs text-slate-400 mt-1">Comma-separated values</p>
            </div>
          </div>

          <!-- Description -->
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Description *</label>
            <textarea name="description" required rows="4"
                      placeholder="Describe the venue, its unique features, surroundings, and what makes it special…"
                      class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 resize-none"><%= venue ? venue.description : '' %></textarea>
          </div>

          <!-- Images -->
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Image URLs</label>
            <textarea name="images" rows="4"
                      placeholder="https://example.com/image1.jpg&#10;https://example.com/image2.jpg"
                      class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 resize-none font-mono"><%= venue ? venue.images.join('\n') : '' %></textarea>
            <p class="text-xs text-slate-400 mt-1">One URL per line. First image is used as the cover photo.</p>
          </div>

          <!-- Amenity quick-add -->
          <div>
            <p class="text-xs font-medium text-slate-500 mb-2">Quick-add amenities:</p>
            <div class="flex flex-wrap gap-2">
              <% ['WiFi', 'Parking', 'AV Equipment', 'Catering', 'Stage', 'Projector', 'Air Conditioning', 'Outdoor Space', 'Bar', 'Kitchen'].forEach(a => { %>
                <button type="button"
                        class="quick-amenity text-xs px-2.5 py-1 rounded-full border border-slate-200 bg-slate-50 text-slate-600
                               hover:bg-indigo-50 hover:border-indigo-300 hover:text-indigo-600 transition-colors"
                        data-amenity="<%= a %>">
                  + <%= a %>
                </button>
              <% }) %>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex gap-3 pt-2">
            <button type="submit" id="save-btn"
                    class="flex-1 sm:flex-none bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-2.5 rounded-xl transition-all active:scale-95 shadow-sm text-sm">
              <%= venue ? 'Save Changes' : 'Create Venue' %>
            </button>
            <a href="/admin/venues"
               class="flex-1 sm:flex-none text-center border border-slate-300 text-slate-700 font-medium px-6 py-2.5 rounded-xl hover:bg-slate-50 transition-colors text-sm">
              Cancel
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  /* Quick-add amenity chips */
  document.querySelectorAll('.quick-amenity').forEach(btn => {
    btn.addEventListener('click', () => {
      const input = document.querySelector('input[name="amenities"]');
      const current = input.value.split(',').map(a => a.trim()).filter(Boolean);
      const newA = btn.dataset.amenity;
      if (!current.includes(newA)) {
        input.value = [...current, newA].join(', ');
        btn.classList.add('bg-indigo-100','border-indigo-300','text-indigo-700');
      }
    });
  });

  document.getElementById('venue-form').addEventListener('submit', () => {
    const btn = document.getElementById('save-btn');
    btn.textContent = 'Saving…'; btn.disabled = true;
  });
</script>

<%- include('../partials/footer') %>
