<%- include('../partials/header', { title: 'Manage Bookings' }) %>
<%- include('../partials/flash-messages') %>

<div class="flex min-h-[calc(100vh-4rem)]">
  <%- include('../partials/sidebar', { activePage: 'admin-bookings' }) %>

  <div class="flex-1 overflow-auto bg-slate-50 p-6 lg:p-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Manage Bookings</h1>
        <p class="text-slate-500 text-sm mt-1"><%= (bookings || []).length %> total bookings</p>
      </div>
      <!-- Status filter tabs -->
      <div class="flex gap-1 bg-slate-100 p-1 rounded-xl text-sm">
        <button class="filter-tab active px-3 py-1.5 rounded-lg font-medium text-slate-700" data-status="all">All</button>
        <button class="filter-tab px-3 py-1.5 rounded-lg font-medium text-slate-500 hover:text-slate-700" data-status="Pending">Pending</button>
        <button class="filter-tab px-3 py-1.5 rounded-lg font-medium text-slate-500 hover:text-slate-700" data-status="Approved">Approved</button>
        <button class="filter-tab px-3 py-1.5 rounded-lg font-medium text-slate-500 hover:text-slate-700" data-status="Rejected">Rejected</button>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-100 shadow-card overflow-hidden">
      <% if ((bookings || []).length === 0) { %>
        <div class="text-center py-16 text-slate-400">No bookings yet.</div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm" id="bookings-table">
            <thead class="bg-slate-50 border-b border-slate-100">
              <tr>
                <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Event</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide hidden md:table-cell">Organiser</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide hidden lg:table-cell">Venue</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide hidden xl:table-cell">Date</th>
                <th class="text-right px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Amount</th>
                <th class="text-center px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Status</th>
                <th class="text-center px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Payment</th>
                <th class="px-4 py-3 text-center text-xs font-semibold text-slate-500 uppercase tracking-wide">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
              <% (bookings || []).forEach(b => { %>
                <tr class="booking-row hover:bg-slate-50/50 transition-colors" data-status="<%= b.bookingStatus %>">
                  <td class="px-6 py-4">
                    <p class="font-medium text-slate-900 truncate max-w-[150px]"><%= b.eventName %></p>
                    <p class="text-xs text-slate-400 mt-0.5">
                      <%= new Date(b.createdAt).toLocaleDateString('en-IN', {day:'numeric', month:'short'}) %>
                    </p>
                  </td>
                  <td class="px-4 py-4 hidden md:table-cell">
                    <p class="text-slate-700 text-xs font-medium"><%= b.organiserId ? b.organiserId.name : '—' %></p>
                    <p class="text-slate-400 text-xs"><%= b.organiserId ? b.organiserId.email : '' %></p>
                  </td>
                  <td class="px-4 py-4 text-slate-600 hidden lg:table-cell text-xs">
                    <%= b.venueId ? b.venueId.name : '—' %>
                  </td>
                  <td class="px-4 py-4 hidden xl:table-cell">
                    <p class="text-xs text-slate-600 whitespace-nowrap">
                      <%= new Date(b.startTime).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'numeric'}) %>
                    </p>
                    <p class="text-xs text-slate-400 whitespace-nowrap">
                      <%= new Date(b.startTime).toLocaleTimeString('en-IN', {hour:'2-digit', minute:'2-digit'}) %> –
                      <%= new Date(b.endTime).toLocaleTimeString('en-IN', {hour:'2-digit', minute:'2-digit'}) %>
                    </p>
                  </td>
                  <td class="px-4 py-4 text-right font-semibold text-slate-900 whitespace-nowrap">
                    ₹<%= b.totalAmount.toLocaleString() %>
                  </td>
                  <td class="px-4 py-4 text-center">
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full
                      <%= b.bookingStatus === 'Approved'  ? 'bg-emerald-50 text-emerald-700' :
                         b.bookingStatus === 'Pending'    ? 'bg-amber-50 text-amber-700'    :
                         b.bookingStatus === 'Completed'  ? 'bg-slate-100 text-slate-600'   :
                                                            'bg-rose-50 text-rose-700' %>">
                      <%= b.bookingStatus %>
                    </span>
                  </td>
                  <td class="px-4 py-4 text-center">
                    <span class="text-xs font-medium
                      <%= b.paymentStatus === 'Paid' ? 'text-emerald-600' : 'text-amber-600' %>">
                      <%= b.paymentStatus %>
                    </span>
                  </td>
                  <td class="px-4 py-4 text-center">
                    <div class="flex items-center justify-center gap-2">
                      <% if (b.bookingStatus === 'Pending') { %>
                        <form action="/admin/bookings/<%= b._id %>/approve?_method=PUT" method="POST">
                          <button type="submit"
                                  class="text-xs bg-emerald-500 hover:bg-emerald-600 text-white font-semibold px-2.5 py-1.5 rounded-lg transition-all active:scale-95">
                            Approve
                          </button>
                        </form>
                        <form action="/admin/bookings/<%= b._id %>/reject?_method=PUT" method="POST">
                          <button type="submit"
                                  class="text-xs bg-rose-500 hover:bg-rose-600 text-white font-semibold px-2.5 py-1.5 rounded-lg transition-all active:scale-95">
                            Reject
                          </button>
                        </form>
                      <% } else { %>
                        <span class="text-xs text-slate-300 font-medium">—</span>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
  /* ─── Status filter tabs ───────────────────────────────────── */
  document.querySelectorAll('.filter-tab').forEach(tab => {
    tab.addEventListener('click', function() {
      document.querySelectorAll('.filter-tab').forEach(t => {
        t.classList.remove('active', 'bg-white', 'text-slate-900', 'shadow-sm');
        t.classList.add('text-slate-500');
      });
      this.classList.add('active', 'bg-white', 'text-slate-900', 'shadow-sm');
      this.classList.remove('text-slate-500');

      const status = this.dataset.status;
      document.querySelectorAll('.booking-row').forEach(row => {
        if (status === 'all' || row.dataset.status === status) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });
  });

  /* Activate first tab styling */
  const firstTab = document.querySelector('.filter-tab.active');
  if (firstTab) firstTab.classList.add('bg-white', 'text-slate-900', 'shadow-sm');
</script>

<%- include('../partials/footer') %>
