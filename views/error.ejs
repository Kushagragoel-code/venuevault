<%- include('partials/header', { title: `Error ${statusCode}` }) %>

<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center px-4 bg-slate-50">
  <div class="text-center max-w-lg">
    <!-- Decorative -->
    <div class="relative inline-flex mb-8">
      <div class="w-32 h-32 rounded-full bg-indigo-50 flex items-center justify-center">
        <span class="text-6xl font-black text-indigo-200"><%= statusCode || 500 %></span>
      </div>
      <div class="absolute -bottom-2 -right-2 w-10 h-10 rounded-full bg-rose-100 flex items-center justify-center">
        <svg class="w-5 h-5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
      </div>
    </div>

    <h1 class="text-2xl font-bold text-slate-900 mb-3">
      <% if (statusCode === 404) { %>
        Page not found
      <% } else if (statusCode === 403) { %>
        Access denied
      <% } else { %>
        Something went wrong
      <% } %>
    </h1>
    <p class="text-slate-500 mb-8 leading-relaxed"><%= message || 'An unexpected error occurred.' %></p>

    <div class="flex flex-wrap gap-3 justify-center">
      <a href="/"
         class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-xl transition-all active:scale-95 shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        Go Home
      </a>
      <button onclick="history.back()"
              class="inline-flex items-center gap-2 border border-slate-300 text-slate-700 font-medium px-5 py-2.5 rounded-xl hover:bg-slate-50 transition-colors">
        Go Back
      </button>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
