<%- include('../partials/header', { title: venue.name }) %>
<%- include('../partials/flash-messages') %>

<!-- FullCalendar CDN (placed early so it is parsed before the calendar div) -->
<link  href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>


<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm text-slate-500 mb-6">
    <a href="/venues" class="hover:text-indigo-600 transition-colors">Venues</a>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-slate-900 font-medium truncate"><%= venue.name %></span>
  </nav>

  <div class="grid lg:grid-cols-3 gap-8">

    <!-- ─── Left: Venue Info ──────────────────────────────────── -->
    <div class="lg:col-span-2 space-y-6">

      <!-- Image gallery -->
      <div class="rounded-2xl overflow-hidden border border-slate-100 shadow-card bg-white">
        <% if (venue.images && venue.images.length > 0) { %>
          <div class="relative">
            <img id="main-image" src="<%= venue.images[0] %>" alt="<%= venue.name %>"
                 class="w-full h-72 sm:h-96 object-cover"
                 onerror="this.src='https://images.unsplash.com/photo-1497366216548-37526070297c?w=800&q=80'" />
            <% if (venue.images.length > 1) { %>
              <div class="absolute bottom-3 left-3 flex gap-2">
                <% venue.images.slice(0, 5).forEach((img, i) => { %>
                  <button onclick="switchImage('<%= img %>')"
                          class="w-8 h-8 rounded-lg border-2 <%= i===0 ? 'border-white' : 'border-white/50' %> overflow-hidden">
                    <img src="<%= img %>" alt="" class="w-full h-full object-cover" />
                  </button>
                <% }) %>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <div class="w-full h-72 bg-gradient-to-br from-indigo-100 to-slate-100 flex items-center justify-center">
            <svg class="w-16 h-16 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5"/>
            </svg>
          </div>
        <% } %>
      </div>

      <!-- Venue details card -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-card p-6 sm:p-8">
        <div class="flex items-start justify-between gap-4 mb-4">
          <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900"><%= venue.name %></h1>
            <p class="text-slate-500 flex items-center gap-1.5 mt-1.5">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              </svg>
              <%= venue.location %>
            </p>
          </div>
          <div class="text-right shrink-0">
            <p class="text-2xl font-bold text-indigo-600">₹<%= venue.pricePerHour.toLocaleString() %></p>
            <p class="text-xs text-slate-400">per hour</p>
          </div>
        </div>

        <!-- Stats row -->
        <div class="grid grid-cols-3 gap-4 p-4 bg-slate-50 rounded-xl mb-6">
          <div class="text-center">
            <p class="text-xl font-bold text-slate-900"><%= venue.capacity %></p>
            <p class="text-xs text-slate-500">Max Guests</p>
          </div>
          <div class="text-center border-x border-slate-200">
            <p class="text-xl font-bold text-slate-900"><%= (venue.amenities || []).length %></p>
            <p class="text-xs text-slate-500">Amenities</p>
          </div>
          <div class="text-center">
            <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold
              <%= venue.status === 'Active' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
              <%= venue.status %>
            </span>
            <p class="text-xs text-slate-500 mt-1">Status</p>
          </div>
        </div>

        <p class="text-slate-600 leading-relaxed mb-6"><%= venue.description %></p>

        <!-- Amenities -->
        <% if (venue.amenities && venue.amenities.length > 0) { %>
          <div>
            <h3 class="text-sm font-semibold text-slate-900 mb-3">Amenities & Features</h3>
            <div class="flex flex-wrap gap-2">
              <% venue.amenities.forEach(a => { %>
                <span class="flex items-center gap-1.5 text-sm px-3 py-1.5 bg-indigo-50 text-indigo-700 rounded-lg font-medium border border-indigo-100">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                  </svg>
                  <%= a %>
                </span>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>

      <!-- ─── Availability Calendar ──────────────────────────── -->
      <div class="bg-white rounded-2xl border border-slate-100 shadow-card p-6">
        <div class="flex items-center gap-2 mb-5">
          <h2 class="text-lg font-semibold text-slate-900">Availability Calendar</h2>
          <div class="flex items-center gap-3 ml-auto text-xs font-medium">
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-rose-500 inline-block"></span> Booked
            </span>
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-amber-400 inline-block"></span> Pending
            </span>
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span> Available
            </span>
          </div>
        </div>

        <!-- FullCalendar CDN loaded at top of file -->

        <div id="calendar" class="fc-custom"></div>
      </div>
    </div>

    <!-- ─── Right: Booking Form ──────────────────────────────── -->
    <div class="lg:col-span-1">
      <div class="sticky top-20 bg-white rounded-2xl border border-slate-100 shadow-card p-6">
        <h2 class="text-lg font-semibold text-slate-900 mb-1">Request a Booking</h2>
        <p class="text-sm text-slate-500 mb-5">Fill in the details and an admin will approve your request.</p>

        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <!-- Booking form (logged in) -->
          <form action="/bookings" method="POST" id="booking-form" class="space-y-4">
            <input type="hidden" name="venueId" value="<%= venue._id %>" />

            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1.5">Event Name</label>
              <input type="text" name="eventName" required placeholder="Annual Sales Conference"
                     class="w-full px-3 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500" />
            </div>

            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1.5">Start Date & Time</label>
              <input type="datetime-local" name="startTime" id="start-time" required
                     class="w-full px-3 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500" />
            </div>

            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1.5">End Date & Time</label>
              <input type="datetime-local" name="endTime" id="end-time" required
                     class="w-full px-3 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500" />
            </div>

            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1.5">Notes (optional)</label>
              <textarea name="notes" rows="2" placeholder="Special requirements, setup needs…"
                        class="w-full px-3 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 resize-none"></textarea>
            </div>

            <!-- Live cost estimate -->
            <div id="cost-estimate" class="hidden bg-indigo-50 border border-indigo-100 rounded-xl p-4">
              <div class="flex justify-between text-sm">
                <span class="text-slate-600">Duration</span>
                <span class="font-semibold text-slate-900" id="est-duration">—</span>
              </div>
              <div class="flex justify-between text-sm mt-1">
                <span class="text-slate-600">Price per hour</span>
                <span class="font-semibold text-slate-900">₹<%= venue.pricePerHour.toLocaleString() %></span>
              </div>
              <div class="border-t border-indigo-200 mt-3 pt-3 flex justify-between">
                <span class="font-semibold text-slate-900">Estimated Total</span>
                <span class="font-bold text-indigo-600 text-lg" id="est-total">₹0</span>
              </div>
            </div>

            <button type="submit" id="book-btn"
                    class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-xl transition-all active:scale-95 shadow-sm">
              Request Booking
            </button>
          </form>

        <% } else { %>
          <!-- Not logged in -->
          <div class="text-center py-6">
            <div class="w-14 h-14 rounded-2xl bg-indigo-50 flex items-center justify-center mx-auto mb-4">
              <svg class="w-7 h-7 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <p class="text-sm font-medium text-slate-700 mb-1">Sign in to book this venue</p>
            <p class="text-xs text-slate-400 mb-5">Create a free account or sign in to request a booking.</p>
            <a href="/login?redirect=/venues/<%= venue._id %>"
               class="block w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-xl transition-all active:scale-95 text-sm text-center">
              Sign In to Book
            </a>
            <a href="/register"
               class="block mt-2 w-full border border-slate-300 text-slate-700 text-sm font-medium py-2.5 rounded-xl hover:bg-slate-50 transition-colors text-center">
              Create Free Account
            </a>
          </div>
        <% } %>

        <!-- Pricing breakdown note -->
        <div class="mt-5 pt-5 border-t border-slate-100">
          <p class="text-xs text-slate-400 flex items-start gap-2">
            <svg class="w-4 h-4 text-indigo-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Booking requests are reviewed by the admin within 24 hours. Payment is due only after approval.
          </p>
        </div>
      </div>
    </div>

  </div>
</main>

<script>
  /* ── FullCalendar ──────────────────────────────────────────── */
  const venueId = '<%= venue._id %>';
  document.addEventListener('DOMContentLoaded', () => {
    const calEl = document.getElementById('calendar');
    const cal   = new FullCalendar.Calendar(calEl, {
      initialView       : 'dayGridMonth',
      height            : 380,
      headerToolbar     : { left: 'prev,next today', center: 'title', right: 'dayGridMonth,timeGridWeek' },
      events            : `/api/venues/${venueId}/bookings`,
      eventDisplay      : 'block',
      dayMaxEvents      : 2,
      nowIndicator      : true,
      selectable        : true,
      selectMirror      : true,
      validRange        : { start: new Date().toISOString().split('T')[0] },
      select: function (info) {
        const s = document.getElementById('start-time');
        const e = document.getElementById('end-time');
        if (s && e) {
          s.value = info.startStr.substring(0,16);
          e.value = info.endStr.substring(0,16);
          updateEstimate();
        }
      },
      eventClick: function (info) {
        alert(`Status: ${info.event.extendedProps.status}\n${info.event.title}\n${info.event.start.toLocaleString()} → ${info.event.end ? info.event.end.toLocaleString() : ''}`);
      }
    });
    cal.render();
  });

  /* ── Live cost estimate ────────────────────────────────────── */
  const pricePerHour = Number('<%= venue.pricePerHour %>') || 0;
  function updateEstimate() {
    const s = document.getElementById('start-time');
    const e = document.getElementById('end-time');
    if (!s || !e || !s.value || !e.value) return;
    const start = new Date(s.value);
    const end   = new Date(e.value);
    if (isNaN(start) || isNaN(end) || end <= start) {
      document.getElementById('cost-estimate').classList.add('hidden');
      return;
    }
    const hours = (end - start) / 3600000;
    const total = (hours * pricePerHour).toFixed(2);
    document.getElementById('est-duration').textContent = hours.toFixed(1) + ' hour(s)';
    document.getElementById('est-total').textContent    = '₹' + parseFloat(total).toLocaleString();
    document.getElementById('cost-estimate').classList.remove('hidden');
  }

  const startEl = document.getElementById('start-time');
  const endEl   = document.getElementById('end-time');
  if (startEl) startEl.addEventListener('change', updateEstimate);
  if (endEl)   endEl.addEventListener('change', updateEstimate);

  /* ── Disable past datetimes ────────────────────────────────── */
  const now = new Date();
  const pad  = n => String(n).padStart(2, '0');
  const localNow = `${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}`;
  if (startEl) startEl.min = localNow;
  if (endEl)   endEl.min   = localNow;
  if (startEl) startEl.addEventListener('change', () => { if (endEl) endEl.min = startEl.value; });

  /* ── Image switcher ────────────────────────────────────────── */
  function switchImage(src) {
    document.getElementById('main-image').src = src;
  }

  /* ── Book button loading state ─────────────────────────────── */
  const bookForm = document.getElementById('booking-form');
  if (bookForm) {
    bookForm.addEventListener('submit', function() {
      const btn = document.getElementById('book-btn');
      btn.textContent = 'Submitting…'; btn.disabled = true;
    });
  }
</script>

<%- include('../partials/footer') %>
