<%- include('../partials/header', { title: 'Browse Venues' }) %>
<%- include('../partials/flash-messages') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

  <!-- Page header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900">Browse Venues</h1>
    <p class="text-slate-500 mt-1">Discover the perfect space for your next event</p>
  </div>

  <!-- ─── Filter Bar ───────────────────────────────────────────── -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-card p-5 mb-8">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
      <!-- Search -->
      <div class="lg:col-span-1">
        <label class="block text-xs font-medium text-slate-500 mb-1.5">Search</label>
        <div class="relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input type="text" id="filter-search" placeholder="Name, location…"
                 class="w-full pl-9 pr-4 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500" />
        </div>
      </div>

      <!-- Capacity -->
      <div>
        <label class="block text-xs font-medium text-slate-500 mb-1.5">Min. Capacity</label>
        <input type="number" id="filter-capacity" placeholder="e.g. 100" min="0"
               class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500" />
      </div>

      <!-- Amenities -->
      <div>
        <label class="block text-xs font-medium text-slate-500 mb-1.5">Amenities</label>
        <input type="text" id="filter-amenities" placeholder="WiFi, Parking, AV…"
               class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500" />
      </div>

      <!-- Search Button -->
      <div class="flex gap-2">
        <button id="btn-filter"
                class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-4 py-2.5 rounded-lg transition-all active:scale-95">
          Search
        </button>
        <button id="btn-reset"
                class="px-4 py-2.5 text-sm font-medium text-slate-600 border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors">
          Reset
        </button>
      </div>
    </div>

    <!-- Amenity quick-select badges -->
    <div class="mt-4 flex flex-wrap gap-2">
      <span class="text-xs text-slate-500 font-medium self-center">Quick filters:</span>
      <% ['WiFi', 'Parking', 'AV Equipment', 'Catering', 'Projector', 'Stage', 'Outdoor'].forEach(a => { %>
        <button class="amenity-badge text-xs px-3 py-1 rounded-full border border-slate-200 bg-slate-50 text-slate-600
                       hover:bg-indigo-50 hover:border-indigo-300 hover:text-indigo-600 transition-colors font-medium"
                data-amenity="<%= a %>">
          <%= a %>
        </button>
      <% }) %>
    </div>
  </div>

  <!-- Results count -->
  <div class="flex items-center justify-between mb-5">
    <p class="text-sm text-slate-500"><span id="result-count"><%= venues.length %></span> venues found</p>
    <div class="flex items-center gap-2 text-sm text-slate-500">
      <span>Sort:</span>
      <select id="sort-select" class="text-sm border border-slate-200 rounded-lg px-2 py-1 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/30">
        <option value="newest">Newest</option>
        <option value="price-asc">Price: Low to High</option>
        <option value="price-desc">Price: High to Low</option>
        <option value="capacity">Capacity</option>
      </select>
    </div>
  </div>

  <!-- ─── Venue Grid ───────────────────────────────────────────── -->
  <div id="venues-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% venues.forEach(venue => { %>
      <div class="venue-card group bg-white rounded-2xl overflow-hidden border border-slate-100 shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-0.5"
           data-name="<%= venue.name.toLowerCase() %>"
           data-capacity="<%= venue.capacity %>"
           data-price="<%= venue.pricePerHour %>">
        <!-- Image -->
        <div class="relative h-48 overflow-hidden bg-slate-100">
          <% if (venue.images && venue.images.length > 0) { %>
            <img src="<%= venue.images[0] %>" alt="<%= venue.name %>"
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                 onerror="this.src='https://images.unsplash.com/photo-1497366216548-37526070297c?w=800&q=80'" />
          <% } else { %>
            <div class="w-full h-full bg-gradient-to-br from-indigo-100 to-slate-100 flex items-center justify-center">
              <svg class="w-12 h-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5"/>
              </svg>
            </div>
          <% } %>
          <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
          <span class="absolute top-3 left-3 text-xs font-semibold px-2.5 py-1 rounded-full
            <%= venue.status === 'Active' ? 'bg-emerald-500 text-white' : 'bg-amber-500 text-white' %>">
            <%= venue.status %>
          </span>
        </div>
        <!-- Content -->
        <div class="p-5">
          <h2 class="text-base font-semibold text-slate-900 truncate mb-1"><%= venue.name %></h2>
          <p class="text-xs text-slate-500 flex items-center gap-1 mb-3">
            <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <%= venue.location %>
          </p>
          <!-- Amenity badges -->
          <div class="flex flex-wrap gap-1.5 mb-4">
            <% (venue.amenities || []).slice(0, 3).forEach(a => { %>
              <span class="text-xs px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 font-medium"><%= a %></span>
            <% }) %>
            <% if ((venue.amenities || []).length > 3) { %>
              <span class="text-xs px-2 py-0.5 rounded-full bg-slate-100 text-slate-500">+<%= venue.amenities.length - 3 %></span>
            <% } %>
          </div>
          <div class="flex items-center justify-between">
            <div>
              <span class="text-xs text-slate-400">Up to</span>
              <span class="text-sm font-semibold text-slate-700 ml-1"><%= venue.capacity %> guests</span>
            </div>
            <span class="text-lg font-bold text-indigo-600">
              ₹<%= venue.pricePerHour.toLocaleString() %>
              <span class="text-xs font-normal text-slate-400">/hr</span>
            </span>
          </div>
          <a href="/venues/<%= venue._id %>"
             class="mt-4 block w-full text-center bg-indigo-50 hover:bg-indigo-600 text-indigo-600 hover:text-white
                    text-sm font-semibold py-2.5 rounded-lg transition-all duration-200">
            View Details →
          </a>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Empty state -->
  <div id="empty-state" class="hidden text-center py-24">
    <div class="w-16 h-16 rounded-2xl bg-slate-100 flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
    </div>
    <h3 class="text-lg font-semibold text-slate-900 mb-1">No venues found</h3>
    <p class="text-slate-500 text-sm">Try adjusting your filters or clearing the search.</p>
  </div>

  <!-- Spinner -->
  <div id="loading-spinner" class="hidden text-center py-16">
    <div class="inline-block w-8 h-8 border-4 border-indigo-200 border-t-indigo-600 rounded-full animate-spin"></div>
    <p class="text-sm text-slate-400 mt-3">Searching venues…</p>
  </div>

</main>

<!-- Initial server-rendered venues JSON for JS -->
<script id="initial-venues-data" type="application/json">
<%- JSON.stringify(venues || []) %>
</script>
<script>
  try {
    const _el = document.getElementById('initial-venues-data');
    window.__INITIAL_VENUES__ = _el ? JSON.parse(_el.textContent) : [];
  } catch (e) {
    window.__INITIAL_VENUES__ = [];
  }
</script>
<script src="/js/venue-filter.js"></script>

<%- include('../partials/footer') %>
