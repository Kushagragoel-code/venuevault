<!-- Dashboard Sidebar -->
<aside class="hidden lg:flex flex-col w-64 shrink-0 bg-white border-r border-slate-200 min-h-[calc(100vh-4rem)] sticky top-16 self-start">
  <div class="p-5 border-b border-slate-100">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-indigo-700 flex items-center justify-center shadow-sm">
        <span class="text-white font-bold text-base"><%= currentUser ? currentUser.name.charAt(0).toUpperCase() : '?' %></span>
      </div>
      <div>
        <p class="text-sm font-semibold text-slate-900 truncate max-w-[140px]"><%= currentUser ? currentUser.name : '' %></p>
        <span class="text-xs font-medium px-2 py-0.5 rounded-full
          <%= currentUser && currentUser.role === 'Admin' ? 'bg-indigo-100 text-indigo-700' : 'bg-emerald-50 text-emerald-700' %>">
          <%= currentUser ? currentUser.role : '' %>
        </span>
      </div>
    </div>
  </div>

  <nav class="flex-1 p-4 space-y-1">
    <% if (currentUser && currentUser.role === 'Admin') { %>
      <!-- Admin Nav -->
      <a href="/admin"
         class="sidebar-link <%= typeof activePage !== 'undefined' && activePage === 'admin-dash' ? 'active' : '' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <span>Dashboard</span>
      </a>
      <a href="/admin/bookings"
         class="sidebar-link <%= typeof activePage !== 'undefined' && activePage === 'admin-bookings' ? 'active' : '' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
        </svg>
        <span>Bookings</span>
      </a>
      <a href="/admin/venues"
         class="sidebar-link <%= typeof activePage !== 'undefined' && activePage === 'admin-venues' ? 'active' : '' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
        </svg>
        <span>Venues</span>
      </a>
      <a href="/admin/venues/new"
         class="sidebar-link">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"/>
        </svg>
        <span>Add Venue</span>
      </a>
    <% } else { %>
      <!-- Organiser Nav -->
      <a href="/dashboard"
         class="sidebar-link <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <span>My Dashboard</span>
      </a>
      <a href="/venues" class="sidebar-link">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <span>Browse Venues</span>
      </a>
    <% } %>
  </nav>

  <div class="p-4 border-t border-slate-100">
    <a href="/logout"
       class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium text-slate-500 hover:text-rose-500 hover:bg-rose-50 transition-colors w-full">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
      </svg>
      <span>Logout</span>
    </a>
  </div>
</aside>
