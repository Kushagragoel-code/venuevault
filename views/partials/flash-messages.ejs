<!-- Flash Messages -->
<% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
  <div id="flash-success"
       class="fixed top-20 right-4 z-50 flex items-start gap-3 bg-white border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl shadow-lg max-w-sm animate-slide-in">
    <div class="mt-0.5 shrink-0 w-5 h-5 rounded-full bg-emerald-500 flex items-center justify-center">
      <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
      </svg>
    </div>
    <p class="text-sm font-medium"><%= success_msg[0] %></p>
    <button onclick="this.parentElement.remove()" class="ml-auto shrink-0 text-emerald-400 hover:text-emerald-600">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>
<% } %>

<% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
  <div id="flash-error"
       class="fixed top-20 right-4 z-50 flex items-start gap-3 bg-white border border-rose-200 text-rose-800 px-4 py-3 rounded-xl shadow-lg max-w-sm animate-slide-in">
    <div class="mt-0.5 shrink-0 w-5 h-5 rounded-full bg-rose-500 flex items-center justify-center">
      <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </div>
    <p class="text-sm font-medium"><%= error_msg[0] %></p>
    <button onclick="this.parentElement.remove()" class="ml-auto shrink-0 text-rose-400 hover:text-rose-600">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>
<% } %>

<script>
  /* Auto-dismiss flash messages after 5 seconds */
  ['flash-success', 'flash-error'].forEach(id => {
    const el = document.getElementById(id);
    if (el) setTimeout(() => el.remove(), 5000);
  });
</script>
